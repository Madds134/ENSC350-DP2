;html=1;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="46" y="370" width="416" height="95" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Up-sweep (N = 8)&lt;/b&gt;&lt;br&gt;gPair(i), pPair(i) = GP[2i+1, 2i]" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="769" y="198" width="330" height="44" as="geometry"/></mxCell><mxCell id="c63" value="Up-sweep (N = 4)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="769" y="308" width="330" height="44" as="geometry"/></mxCell><mxCell id="c64" value="Inner BLAN, N = 2 (dotted box)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="769" y="418" width="330" height="44" as="geometry"/></mxCell><mxCell id="c65" value="Down-sweep (N = 4)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="769" y="528" width="330" height="44" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Down-sweep (N = 8)&lt;/b&gt;&lt;br&gt;Gpre(2i) = g(2i) + p(2i)·GPairPre(i−1)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="769" y="638" width="330" height="44" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;Inner BLAN, N = 4&lt;/b&gt; (dashed box)&lt;br&gt;on the odd positions 1, 3, 5, 7&lt;br&gt;outputs GPairPre(i) = GP[2i+1, 0]" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="769" y="252" width="330" height="52" as="geometry"/></mxCell><mxCell id="c68" value="Odd positions take GP[2i+1, 0] straight from the inner BLAN; position 0 is a wire.&lt;br&gt;11 merge cells (2N − 2 − log&lt;sub&gt;2&lt;/sub&gt;N), depth 5 (2 log&lt;sub&gt;2&lt;/sub&gt;N − 1)." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="787" width="690" height="40" as="geometry"/></mxCell><mxCell id="c69" style="html=1;rounded=0;strokeColor=#000000;endArrow=classic;endSize=7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="829" y="750" as="sourcePoint"/><mxPoint x="829" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" style="html=1;rounded=0;strokeColor=#000000;endArrow=none;endSize=7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="884" y="765" as="sourcePoint"/><mxPoint x="829" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="880.5" y="761.5" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c72" value="∘" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=40;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="814" y="795" width="30" height="30" as="geometry"/></mxCell><mxCell id="c73" value="hi&lt;br&gt;(position i)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="734" y="745" width="80" height="36" as="geometry"/></mxCell><mxCell id="c74" value="lo&lt;br&gt;(lower position)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="891" y="745" width="110" height="36" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Merge cell ∘&lt;/b&gt;&lt;br&gt;G = G&lt;sub&gt;hi&lt;/sub&gt; + P&lt;sub&gt;hi&lt;/sub&gt;·G&lt;sub&gt;lo&lt;/sub&gt;&lt;br&gt;P = P&lt;sub&gt;hi&lt;/sub&gt;·P&lt;sub&gt;lo&lt;/sub&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="859" y="815" width="200" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>