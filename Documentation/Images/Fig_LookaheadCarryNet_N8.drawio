lue="c(6)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="370" y="754" width="46" height="20" as="geometry"/></mxCell><mxCell id="c102" style="html=1;rounded=0;strokeColor=#000000;endArrow=classic;endSize=7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="228" y="752" as="sourcePoint"/><mxPoint x="228" y="697" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c103" value="g(6)&lt;br&gt;p(6)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="754" width="56" height="34" as="geometry"/></mxCell><mxCell id="c104" style="html=1;rounded=0;strokeColor=#000000;endArrow=classic;endSize=7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="272" y="697" as="sourcePoint"/><mxPoint x="272" y="752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c105" value="c(7)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="252" y="754" width="46" height="20" as="geometry"/></mxCell><mxCell id="c106" style="html=1;rounded=0;strokeColor=#000000;endArrow=classic;endSize=7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="752" as="sourcePoint"/><mxPoint x="110" y="697" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c107" value="g(7)&lt;br&gt;p(7)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="754" width="56" height="34" as="geometry"/></mxCell><mxCell id="c108" style="html=1;rounded=0;strokeColor=#000000;endArrow=classic;endSize=7;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="154" y="697" as="sourcePoint"/><mxPoint x="154" y="752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c109" value="c(8)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="134" y="754" width="46" height="20" as="geometry"/></mxCell><mxCell id="c110" value="&lt;b&gt;Carries, not prefixes.&lt;/b&gt;&lt;br&gt;Cin enters at the root and is pushed down: each node gives its low half the node's Cin and its high half cMid = BGL + BPL·Cin, while BG, BP of each half go up to the parent.&lt;br&gt;&lt;br&gt;The leaves output the carries c(i+1) themselves, and c(0) = Cin. No GP[i, 0] prefixes and no separate carry stage, unlike the BLAN of the prefix adders." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1043" y="275" width="250" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>