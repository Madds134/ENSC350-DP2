<mxfile host="drawio-cli">
  <diagram name="TBAdder MAIN" id="tbmain">
    <mxGraphModel dx="1000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="TBAdder: MAIN process (one measurement per test vector)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="0" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- Main column -->
        <mxCell id="start" value="Open TestVectorFile (generic); assert open_ok&lt;br&gt;Report header: N, file, PreStimTime, StableTime, Timeout&lt;br&gt;Measurement_Index := 1, Failures := 0, WorstS := WorstStatus := 0 ns" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="40" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="eof" value="endfile?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="145" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="final" value="Report: &lt;i&gt;Simulation Completed: K measurements, F failures | worst S delay (meas i) | worst Status delay (meas j)&lt;/i&gt;&lt;br&gt;Close file; stop" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="590" y="135" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="read" value="readline; read A, B, Cin, S, Cout, Ovfl&lt;br&gt;assert LineOK (else: malformed vector, stop)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="140" y="245" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="xstim" value="TBA, TBB, TBCin &amp;lt;= 'X'&lt;br&gt;wait for PreStimTime (100 ns)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="140" y="325" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="apply" value="TBA &amp;lt;= A, TBB &amp;lt;= B, TBCin &amp;lt;= Cin&lt;br&gt;TBtrueS, TBtrueCout, TBtrueOvfl &amp;lt;= expected&lt;br&gt;T0 := now" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="140" y="405" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wait" value="wait on TBS, TBCout, TBOvfl&lt;br&gt;for StableTime (20 ns)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="140" y="500" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="stable" value="No output event for StableTime,&lt;br&gt;or now − T0 ≥ Timeout?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="170" y="580" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="delays" value="Elapsed := now − T0;  assert Elapsed &amp;lt; Timeout&lt;br&gt;DelayS := Elapsed − TBS'last_event&lt;br&gt;DelayStatus := Elapsed − (later of TBCout, TBOvfl)&lt;br&gt;TBDelayS, TBDelayStatus &amp;lt;= delays (wave window)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="715" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="worst" value="if DelayS &amp;gt; WorstS: WorstS, WorstSIndex := DelayS, Measurement_Index&lt;br&gt;same for DelayStatus → WorstStatus, WorstStatusIndex" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="830" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="check" value="TBS = TBtrueS and&lt;br&gt;TBCout = TBtrueCout and&lt;br&gt;TBOvfl = TBtrueOvfl?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="180" y="915" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pass" value="Status := &quot;PASS&quot;&lt;br&gt;Level := note" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="1060" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="Status := &quot;FAIL&quot;, Level := error&lt;br&gt;Failures := Failures + 1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="410" y="1060" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="report" value="report &lt;i&gt;Meas i PASS/FAIL | A, B, Cin | expected | actual | delay S, Status&lt;/i&gt; (severity Level)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="1140" width="500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="incr" value="Measurement_Index := Measurement_Index + 1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="170" y="1220" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- Flow edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="eof"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="eof" target="final"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="eof" target="read"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="read" target="xstim"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="xstim" target="apply"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="apply" target="wait"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="wait" target="stable"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="stable" target="delays"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=14;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stable" target="wait">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="635" /><mxPoint x="110" y="527" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="delays" target="worst"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="worst" target="check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=14;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="check" target="pass"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="check" target="fail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pass" target="report"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fail" target="report"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="report" target="incr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="next vector" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=14;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="incr" target="eof">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="1240" /><mxPoint x="20" y="180" /></Array></mxGeometry>
        </mxCell>

        <!-- Annotations: why each constant has its value -->
        <mxCell id="n1" value="&lt;b&gt;PreStimTime = 100 ns&lt;/b&gt;: longer than any path delay (Baseline STA path 41.7 ns), so every output turns 'X' first and the vector always causes a final transition to measure." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;fontSize=13;strokeColor=#1F5FBF;fontColor=#1F5FBF;" vertex="1" parent="1">
          <mxGeometry x="590" y="305" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;StableTime = 20 ns&lt;/b&gt;: longer than any gap between transitions of a settling output (longest wire hop on a critical path ≈ 2.8 ns).&lt;br&gt;&lt;b&gt;Timeout = 500 ns&lt;/b&gt;: safety limit, so a faulty DUT cannot hang the run." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;fontSize=13;strokeColor=#1F5FBF;fontColor=#1F5FBF;" vertex="1" parent="1">
          <mxGeometry x="590" y="560" width="390" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;'last_event&lt;/b&gt; = time since the signal last changed, so (now − T0) − 'last_event is the time of its final transition after the vector was applied. Status = Cout or Ovfl, whichever settled later." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;fontSize=13;strokeColor=#1F5FBF;fontColor=#1F5FBF;" vertex="1" parent="1">
          <mxGeometry x="590" y="715" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="The worst delays and their vector indices are reported in the final line (read by CollectTiming.tcl)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;fontSize=13;strokeColor=#1F5FBF;fontColor=#1F5FBF;" vertex="1" parent="1">
          <mxGeometry x="590" y="830" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l1" style="html=1;endArrow=none;dashed=1;strokeColor=#1F5FBF;" edge="1" parent="1" source="n1" target="xstim"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l2" style="html=1;endArrow=none;dashed=1;strokeColor=#1F5FBF;" edge="1" parent="1" source="n2" target="stable"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l3" style="html=1;endArrow=none;dashed=1;strokeColor=#1F5FBF;" edge="1" parent="1" source="n3" target="delays"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l4" style="html=1;endArrow=none;dashed=1;strokeColor=#1F5FBF;" edge="1" parent="1" source="n4" target="worst"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
