# Quartus build output (regenerated on every compile)
db/
incremental_db/
output_files/
*.qws

# ModelSim build output
Simulation/work/
# Compiled netlist libraries, one per candidate (made by the TS scripts)
Simulation/*_CIV/
Simulation/*_CIV_N*/
Simulation/*_CIVE30/
Simulation/*_CIVE30_N*/
Simulation/*_AII/
Simulation/*_AII_N*/
Simulation/transcript
*.wlf
*.cr.mti
# ModelSim's compiled SDF cache (made next to each .sdo by the TS runs)
*.csd
*.vcd

# NOTE: unlike DP1, Simulation/ModelSim/ is tracked. DP2 spec task 3b asks for the
# renamed timing models (.vho/.sdo) to be stored in the project, and the TS*.do scripts need them.

# Editor and tool backups
*.bak
*.bkp

# Per-corner netlist copies and helper files written by Quartus next to each default netlist.
# The TS scripts only use <candidate>.vho + <candidate>_vhd.sdo (the default corner), so the
# copies stay local. (Copies committed before this rule are still tracked.)
Simulation/ModelSim/*_slow.vho
Simulation/ModelSim/*_fast.vho
Simulation/ModelSim/*_slow.sdo
Simulation/ModelSim/*_fast.sdo
Simulation/ModelSim/*.sft
Simulation/ModelSim/*.xrf
